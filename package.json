{
  "name": "tglib-bench-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "cf-typegen": "wrangler types",
    "typecheck": "pnpm run cf-typegen && tsc --noEmit && tsc --project tsconfig.node.json --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "update-results": "tsx update_results.ts"
  },
  "dependencies": {
    "preact": "^10.26.4",
    "preact-render-to-string": "^6.5.13"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "wrangler": "^4.151.3"
  }
}
